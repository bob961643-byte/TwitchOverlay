{
  "name": "twitchoverlay",
  "version": "1.0.5",
  "description": "Twitch Overlay",
  "main": "main.js",
  "scripts": {
    "test": "node self-test.js",
    "start": "electron .",
    "build": "electron-builder",
    "clean:dist": "powershell -NoProfile -Command \"if (Test-Path dist) { Get-ChildItem dist -Force | Remove-Item -Recurse -Force }\"",
    "build:clean": "npm run clean:dist && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.twitchoverlay.app",
    "productName": "Twitch Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!*.zip"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "Twitch-Overlay-Setup-${version}.${ext}",
      "shortcutName": "Twitch Overlay"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bob961643-byte",
        "repo": "TwitchOverlay",
        "releaseType": "release"
      }
    ]
  }
}
